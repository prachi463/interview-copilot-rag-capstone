# Copy this file to .env and fill in ONE of the keys below.
# If neither is set, the app still runs using an extractive fallback (no LLM needed).

# Free tier, fast, recommended: https://console.groq.com/keys
GROQ_API_KEY=

# Optional alternative: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Optional: switch to a transformer-based embedder for better semantic recall
# (downloads model weights on first run). Default is "tfidf" (no downloads).
EMBEDDING_BACKEND=tfidf
